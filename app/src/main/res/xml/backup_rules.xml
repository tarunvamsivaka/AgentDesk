<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        AgentDesk: Backup disabled by default.
        Local-first means nothing leaves the device without explicit consent.
    -->
    <exclude domain="root" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
