<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        AgentDesk: No cloud backup by default.
        All user data is private and stays on device.
    -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
