<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- =======================================================================
         PACKAGE VISIBILITY QUERIES (Android 11+ / API 30+)
         Required for Intent-launching system tools to resolve external activities
         ======================================================================= -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="com.android.alarm.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="com.android.alarm.action.SET_TIMER" />
        </intent>
    </queries>

</manifest>
